#include <iostream>
using namespace std;
int main()
{
    const int ROWS = 4;
    const int COLM=4;

  //remember if want to store letter change the int to char


    char board [ROWS][COLM]={
        {'4','0','0','1'},
        {'0','0','4','2'},
        {'2','3','0','4'},
       {'1','4','0','0'},
   };
    
    
  //  board[0][1]= ' ';
  //  board[0][3]= 'a';
    
    cout<<"your answer is  "<<board[0][1]<<endl;
    int c;
    int r=0;
    cout<< "r";
    cin>>r;
    cout<<'c';
    cin>>c;
    for (int c=0;c<COLM;c++){
        cout<<board[r][c];
    }
    return 0;
}

